FROM mirror.gcr.io/library/node:22-alpine
WORKDIR /app

RUN echo "============================================" && \
    echo "  BUILDING FROM: Dockerfile.mcp" && \
    echo "============================================"

COPY . .
RUN npm install
RUN npm run build

ENV PORT=3000
ENV HOST=0.0.0.0

EXPOSE 3000
CMD ["sh", "-c", "echo '>>> STARTED FROM: Dockerfile.mcp <<<' && npm run start"]
